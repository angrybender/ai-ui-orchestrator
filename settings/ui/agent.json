{
  "title": "Agent",
  "groups": [
    {
      "title": "Agent shell",
      "fields": [
        {
          "id": "shell",
          "type": "string",
          "required": true,
          "sub_type": "big"
        },
        {
          "id": "agent_timeout",
          "type": "integer",
          "required": true,
          "default": 7200
        },
        {
          "id": "acp_wait_background_tasks",
          "type": "checkbox",
          "title": "ACP wait background tasks",
          "default": false
        },
        {
          "id": "acp_background_quiet_timeout",
          "type": "integer",
          "title": "ACP background quiet timeout (seconds)",
          "description": "ACP background quiet timeout, in seconds. Applies when waiting for background tasks.",
          "required": true,
          "default": 60
        }
      ]
    },
    {
      "title": "System append prompt",
       "fields": [
         {
          "id": "prompt",
          "type": "text",
          "required": true,
          "default": "during agent taskl dont request any queries to user, do work after creating plan, if there are several variant implementation -- choose optimal without request"
        }
       ]
    }
  ]
}