     });
 
+    it.each(["single", "double"])("resolves a %s-quoted exec-optimized program and stops only that task", async quoting => {
+        const {workloads, token} = await scope();
+        const owned = await child(token); const unrelated = await child("unrelated");
+        const code = "console.log('ready');setInterval(()=>{},1000)";
+        const argument = quoting === "single" ? "'" + code.replaceAll("'", "'\\''") + "'" : JSON.stringify(code);
+        const command = process.execPath + " -e " + argument;
+        const pid = await workloads.resolvePid("thread-1", command);
+        expect(pid).toBe(owned.pid);
+        await workloads.capture("thread-1", "quoted", pid);
+        expect(await workloads.stopTask("thread-1", "quoted", pid)).toBe(true);
+        expect(await workloads.snapshot("thread-1")).toEqual([]);
+        expect(() => process.kill(unrelated.pid!, 0)).not.toThrow();
+    });
+
+    it("refuses ambiguous quoted commands and never evaluates shell substitutions", async () => {
+        const {workloads, token} = await scope();
+        await child(token); await child(token);
+        const code = JSON.stringify("console.log('ready');setInterval(()=>{},1000)");
+        await expect(workloads.resolvePid("thread-1", process.execPath + " -e " + code)).rejects.toThrow("Ambiguous");
+        expect(await workloads.resolvePid("thread-1", "$(printf " + process.execPath + ") -e " + code)).toBeNull();
+        expect(await workloads.resolvePid("thread-1", process.execPath + " -e " + code + " | cat")).toBeNull();
+        await workloads.stopSession("thread-1");
+    });
+
