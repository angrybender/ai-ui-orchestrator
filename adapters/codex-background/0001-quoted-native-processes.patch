 const pause = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
 
+/** Read literal shell words without evaluating substitutions, expansions or operators. */
+function literalArguments(command: string): string[] | null {
+    const words: string[] = [];
+    let word = "";
+    let started = false;
+    let quote: "'" | '"' | null = null;
+    for (let index = 0; index < command.length; index++) {
+        const char = command[index]!;
+        if (quote === "'") {
+            if (char === "'") quote = null;
+            else word += char;
+        } else if (char === "\\") {
+            const next = command[++index];
+            if (next === undefined) return null;
+            if (next === "\n") continue;
+            word += quote === '"' && !['"', "\\", "$", "`"].includes(next) ? "\\" + next : next;
+            started = true;
+        } else if (quote === '"') {
+            if (char === '"') quote = null;
+            else if (char === "$" || char === "`") return null;
+            else word += char;
+        } else if (char === "'" || char === '"') {
+            quote = char;
+            started = true;
+        } else if (char === " " || char === "\t") {
+            if (started) {words.push(word); word = ""; started = false;}
+        } else {
+            if (/[;&|<>$()`\n*?\[\]{}~#]/.test(char)) return null;
+            word += char;
+            started = true;
+        }
+    }
+    if (quote !== null) return null;
+    if (started) words.push(word);
+    return words.length > 0 ? words : null;
+}
